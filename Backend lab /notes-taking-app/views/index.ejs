<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Notes Taking App</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <header>
            <h1>📝 Notes Taking App</h1>
            <p>Write, save and manage your notes <br>
               <b>Hrishitha badavath 590015596</b> 
            </p>
        </header>


        <!-- Add Note Form -->

        <section class="note-form">

            <h2>Create a New Note</h2>

            <form action="/notes" method="POST">

                <input
                    type="text"
                    name="title"
                    placeholder="Enter note title"
                    required
                >

                <textarea
                    name="content"
                    placeholder="Write your note here..."
                    required
                ></textarea>

                <button type="submit">
                    Add Note
                </button>

            </form>

        </section>


        <!-- Display Saved Notes -->

        <section>

            <h2>My Notes</h2>

            <div class="notes-container">

                <% if (notes.length === 0) { %>

                    <div class="empty-message">
                        <p>No notes yet. Create your first note!</p>
                    </div>

                <% } %>


                <% notes.forEach(note => { %>

                    <div class="note-card">

                        <h3>
                            <%= note.title %>
                        </h3>

                        <p class="note-content">
                            <%= note.content %>
                        </p>


                        <div class="timestamps">

                            <p>
                                Created:
                                <%= note.createdAt.toLocaleString() %>
                            </p>

                            <p>
                                Updated:
                                <%= note.updatedAt.toLocaleString() %>
                            </p>

                        </div>


                        <div class="actions">

                            <a
                                href="/notes/edit/<%= note._id %>"
                                class="edit-btn"
                            >
                                Edit
                            </a>


                            <form
                                action="/notes/delete/<%= note._id %>"
                                method="POST"
                                class="delete-form"
                            >

                                <button
                                    type="submit"
                                    class="delete-btn"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>

        </section>

    </div>

</body>

</html>